{
  "mcpServers": {
    "ficheros": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/datos"],
      "tools": [
        {"name": "leer_fichero", "annotations": {"readOnlyHint": true}},
